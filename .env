# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Echte Werte (Datenbank-Passwort, APP_SECRET, ggf. Gemini-Key) gehören in .env.local.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Basis-URL für Links, die außerhalb von HTTP-Requests erzeugt werden (Cron, E-Mails, Sitemap).
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MySQL 8: serverVersion an die echte Version anpassen (SELECT VERSION();)
# MariaDB z. B.: ...?serverVersion=10.11.6-MariaDB&charset=utf8mb4
DATABASE_URL="mysql://sammlung:CHANGE_ME@127.0.0.1:3306/sammlung?serverVersion=8.0.36&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
# z. B. smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
###< symfony/mailer ###

###> app ###
APP_TIMEZONE=Europe/Berlin

# Absender für Benachrichtigungs-Mails (muss vom Mailserver erlaubt sein)
MAILER_FROM=mail@localhost

# Ordner, in den die Exponio-App hochlädt (ein Unterordner je Objekt). Die Website liest ihn nur
# und verändert dort nichts – so bleiben die Originale bei jedem Update erhalten.
# Standard: ein Ordner "app_uploads" neben dem Projektordner (z. B. domain/app_uploads und domain/live).
SCAN_DIR=%kernel.project_dir%/../app_uploads
# Ablage der erzeugten Webbilder. Leer = public/media. Empfohlen außerhalb des Projektordners,
# z. B. %kernel.project_dir%/../media, mit Symlink public/media → dieser Ordner.
MEDIA_DIR=

# KI für Bilderkennung und Übersetzungen: "gemini" oder "anthropic" (Standard, im Backend unter Einstellungen → KI
# umschaltbar) bzw. "fake" (Entwicklung/Tests, ohne Kosten; hat immer Vorrang).
AI_PROVIDER=gemini
# Die API-Keys gibst du im Backend ein (Einstellungen → KI, verschlüsselt gespeichert).
# Stehen sie hier bzw. in .env.local, haben diese Werte Vorrang.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Standard-Modelle (im Backend änderbar). Aktuelle Liste: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite
# Claude: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TRANSLATION_MODEL=claude-haiku-5-5

# Vite-Dev-Server (nur Entwicklung, "npm run dev"), z. B. http://localhost:5173 – leer = gebaute Assets
VITE_DEV_SERVER=
###< app ###
