{# Kartenraster für Merkliste und ähnliche Listen; Variable: items #}
{% if items is not empty %}
    <ul class="grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 xl:grid-cols-4">
        {% for item in items %}
            <li>{{ include('front/partials/_card.html.twig', {item: item}) }}</li>
        {% endfor %}
    </ul>
{% endif %}
