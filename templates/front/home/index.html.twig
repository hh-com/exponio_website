{% extends 'base.html.twig' %}

{% set canonical = path('home') %}

{% block head %}
    {{ json_ld({
        '@type': 'WebSite',
        name: settings.siteName,
        description: settings.tagline(locale),
        url: url('home'),
        inLanguage: locale,
        potentialAction: {
            '@type': 'SearchAction',
            target: {'@type': 'EntryPoint', urlTemplate: url('catalog') ~ '?q={search_term_string}'},
            'query-input': 'required name=search_term_string',
        },
        publisher: settings.ownerName ? {'@type': 'Person', name: settings.ownerName} : null,
    }) }}
{% endblock %}

{% block body %}
    {% set heroItems = (featured is not empty ? featured : latest)|filter(i => i.mainImage)|slice(0, 3) %}
    {% set areasWithItems = nav_areas()|filter(a => area_count(a) > 0) %}

    {# ---------- Hero ---------- #}
    <section class="relative overflow-hidden" aria-labelledby="hero-title">
        <div class="container-page relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:py-24">
            <div class="animate-slide-up">
                <p class="eyebrow">{{ 'home.eyebrow'|trans }}</p>
                <h1 id="hero-title" class="mt-3 text-4xl leading-[1.06] text-balance sm:text-5xl lg:text-6xl">{{ settings.siteName }}</h1>
                {% if settings.tagline(locale) %}
                    <p class="mt-5 max-w-xl text-lg text-pretty text-muted sm:text-xl">{{ settings.tagline(locale) }}</p>
                {% endif %}
                {% if settings.intro(locale) %}
                    <p class="mt-4 max-w-xl text-pretty whitespace-pre-line text-muted">{{ settings.intro(locale) }}</p>
                {% endif %}

                <div class="mt-8 max-w-xl" data-island="search-box" data-props="{{ {endpoint: path('api_suggest'), catalogUrl: path('catalog'), placeholder: 'nav.search_placeholder'|trans, size: 'lg', label: 'home.browse'|trans}|json_encode|e('html_attr') }}">
                    <form action="{{ path('catalog') }}" role="search" class="relative" aria-label="{{ 'home.browse'|trans }}">
                        <label class="sr-only" for="hero-q">{{ 'vue.search'|trans }}</label>
                        <input id="hero-q" name="q" type="search" class="input h-14 rounded-full ps-6 pe-32 text-base shadow-card" placeholder="{{ 'nav.search_placeholder'|trans }}">
                        <button type="submit" class="btn btn-primary absolute top-1/2 end-1.5 -translate-y-1/2">{{ 'vue.search'|trans }}</button>
                    </form>
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-3">
                    <a href="{{ path('catalog') }}" class="btn btn-primary">{{ 'home.browse'|trans }} {{ icon('arrow-right', 'size-4 flip-rtl') }}</a>
                    <a href="{{ path('contact') }}" class="btn btn-secondary">{{ icon('mail', 'size-4') }} {{ 'home.cta_button'|trans }}</a>
                </div>

                {% if stats.count > 0 %}
                    <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-line pt-6">
                        <div>
                            <dt class="text-sm text-muted">{{ 'home.stats_items'|trans }}</dt>
                            <dd class="mt-1 font-display text-2xl tabular-nums">{{ stats.count|number_local }}</dd>
                        </div>
                        <div>
                            <dt class="text-sm text-muted">{{ 'home.stats_regions'|trans }}</dt>
                            <dd class="mt-1 font-display text-2xl tabular-nums">{{ regionCounts|filter(c => c > 0)|length|number_local }}</dd>
                        </div>
                        {% if stats.minYear %}
                            <div>
                                <dt class="text-sm text-muted">{{ 'home.stats_years'|trans }}</dt>
                                <dd class="mt-1 font-display text-xl whitespace-nowrap tabular-nums sm:text-2xl">{{ stats.minYear }}–{{ stats.maxYear }}</dd>
                            </div>
                        {% endif %}
                    </dl>
                {% endif %}
            </div>

            {# Collage der ersten Stücke (dekorativ) #}
            <div class="relative mx-auto hidden h-[440px] w-full max-w-lg sm:block" aria-hidden="true">
                {% set positions = ['start-[4%] top-[8%] w-[46%] -rotate-6', 'end-[2%] top-[2%] w-[42%] rotate-[5deg]', 'start-[28%] bottom-[2%] w-[44%] rotate-2'] %}
                {% for i in 0..2 %}
                    {% set hero = heroItems[i] ?? null %}
                    <div class="absolute {{ positions[i] }} rounded-2xl bg-white p-3 shadow-lift ring-1 ring-line/70">
                        <div class="mount aspect-[4/5] rounded-xl">
                            {% if hero %}
                                <img src="{{ img(hero.mainImage, 400) }}" alt="" class="p-3" width="{{ hero.mainImage.width }}" height="{{ hero.mainImage.height }}">
                            {% else %}
                                <span class="text-brand-300">{{ icon(['stamp', 'envelope', 'coin'][i], 'size-20') }}</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% if stats.count == 0 %}
        <section class="container-page py-20 text-center">
            <p class="text-lg text-muted">{{ 'home.empty'|trans }}</p>
        </section>
    {% endif %}

    {# ---------- Objektarten ---------- #}
    {% if areasWithItems|length > 1 %}
        <section class="container-page pt-6" aria-labelledby="home-areas">
            <h2 id="home-areas" class="text-2xl sm:text-3xl">{{ 'home.areas_title'|trans }}</h2>
            <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-5">
                {% for area in areasWithItems %}
                    <li>
                        <a href="{{ area_url(area) }}" class="area-tile">
                            <span class="area-tile__icon">{{ icon(area.icon, 'size-7') }}</span>
                            <span class="text-base leading-tight font-semibold">{{ area.name(locale) }}</span>
                            <span class="text-sm text-muted">{{ 'common.items'|trans({'%count%': area_count(area)}) }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {# ---------- Ausgewählte Stücke ---------- #}
    {% if featured is not empty %}
        <section class="pt-16 sm:pt-20" aria-labelledby="home-featured">
            <div class="container-page">
                <h2 id="home-featured" class="text-2xl sm:text-3xl">{{ 'home.featured'|trans }}</h2>
                <ul class="-mx-4 mt-6 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 scrollbar-none sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible sm:px-0 lg:grid-cols-4">
                    {% for item in featured %}
                        <li class="w-[68%] shrink-0 snap-start sm:w-auto">{{ include('front/partials/_card.html.twig', {item: item}) }}</li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}

    {# ---------- Neu in der Sammlung ---------- #}
    {% if latest is not empty %}
        <section class="container-page pt-16 sm:pt-20" aria-labelledby="home-latest">
            <div class="flex items-end justify-between gap-4">
                <h2 id="home-latest" class="text-2xl sm:text-3xl">{{ 'home.latest'|trans }}</h2>
                <a href="{{ path('catalog') }}" class="btn btn-ghost -me-3 shrink-0">{{ 'common.show_all'|trans }} {{ icon('arrow-right', 'size-4 flip-rtl') }}</a>
            </div>
            <div class="mt-6">{{ include('front/partials/_cards.html.twig', {items: latest}) }}</div>
        </section>
    {% endif %}

    {# ---------- Länder & Themen ---------- #}
    {% if regions is not empty or topics is not empty %}
        <section class="container-page grid gap-12 pt-16 sm:pt-20 lg:grid-cols-2 lg:gap-16">
            {% if regions is not empty %}
                <div>
                    <div class="flex items-end justify-between gap-4">
                        <h2 class="text-2xl sm:text-3xl">{{ 'home.regions_title'|trans }}</h2>
                        <a href="{{ path('regions') }}" class="btn btn-ghost -me-3 shrink-0">{{ 'common.show_all'|trans }}</a>
                    </div>
                    <ul class="mt-6 grid gap-2 sm:grid-cols-2">
                        {% for region in regions %}
                            <li>
                                <a href="{{ category_url(region) }}" class="group flex min-h-12 items-center gap-3 rounded-xl bg-white px-4 py-3 ring-1 ring-line/70 transition hover:shadow-card">
                                    <span class="text-ink">{{ icon('globe', 'size-5') }}</span>
                                    <span class="flex-1 truncate font-semibold">{{ region.name(locale) }}</span>
                                    <span class="text-sm text-muted tabular-nums">{{ regionCounts[region.id] ?? 0 }}</span>
                                    {{ icon('chevron-right', 'size-4 text-muted flip-rtl') }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            {% if topics is not empty %}
                <div>
                    <div class="flex items-end justify-between gap-4">
                        <h2 class="text-2xl sm:text-3xl">{{ 'home.topics_title'|trans }}</h2>
                        <a href="{{ path('topics') }}" class="btn btn-ghost -me-3 shrink-0">{{ 'common.show_all'|trans }}</a>
                    </div>
                    <ul class="mt-6 flex flex-wrap gap-2">
                        {% for topic in topics %}
                            <li>
                                <a href="{{ topic_url(topic) }}" class="chip">
                                    {{ topic.name(locale) }} <span class="text-xs text-muted tabular-nums">{{ topicCounts[topic.id] ?? 0 }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </section>
    {% endif %}

    {# ---------- Kontakt ---------- #}
    <section class="container-page pt-16 sm:pt-20" aria-labelledby="home-contact">
        <div class="relative overflow-hidden rounded-3xl bg-ink px-6 py-10 text-white sm:px-12 sm:py-14">
            <div class="relative max-w-xl">
                <div class="gradient-rule" aria-hidden="true"></div>
                <h2 id="home-contact" class="mt-5 text-2xl text-white sm:text-3xl">{{ 'home.cta_title'|trans }}</h2>
                <p class="mt-3 text-white/85">{{ 'home.cta_text'|trans }}</p>
                <a href="{{ path('contact') }}" class="btn mt-7 bg-white text-ink hover:bg-soft">{{ icon('mail', 'size-4') }} {{ 'home.cta_button'|trans }}</a>
            </div>
        </div>
    </section>
{% endblock %}
