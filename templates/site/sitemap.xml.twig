<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for entry in entries %}
    <url>
        <loc>{{ entry.urls[locale] }}</loc>
{% if entry.lastmod %}        <lastmod>{{ entry.lastmod }}</lastmod>
{% endif %}
{% if entry.urls|length > 1 %}
{% for code, href in entry.urls %}        <xhtml:link rel="alternate" hreflang="{{ code }}" href="{{ href }}"/>
{% endfor %}
{% if entry.urls.de is defined %}        <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.urls.de }}"/>
{% endif %}
{% endif %}
{% for image in entry.images %}        <image:image><image:loc>{{ absolute_url(image) }}</image:loc></image:image>
{% endfor %}
    </url>
{% endfor %}
</urlset>
